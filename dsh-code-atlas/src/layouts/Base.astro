---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DSH（deepseek-harness）源码深度分析：哆啦A梦带队，逐行吃透插件式 agent harness' } = Astro.props;

const chapters = [
  { slug: '01-plugin-universe', num: '01', title: '插件宇宙观' },
  { slug: '02-loader', num: '02', title: '装载与卸载' },
  { slug: '03-capability-seam', num: '03', title: '接口学' },
  { slug: '04-session-memory', num: '04', title: '记忆真相' },
  { slug: '05-agent-loop', num: '05', title: '循环内部' },
  { slug: '06-layers-approval', num: '06', title: '分层与审批' },
  { slug: '07-subagent', num: '07', title: '分身术' },
  { slug: '08-self-mod-compaction', num: '08', title: '自改装与瘦身' },
  { slug: '09-production', num: '09', title: '走向生产' },
];
const currentChapter = chapters.find((c) => Astro.url.pathname.startsWith(`/chapters/${c.slug}`));
const inAppendix = Astro.url.pathname.startsWith('/appendix');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · DSH 源码图鉴</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-[#d5e3f0] bg-card/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-2.5">
        <a href="/" class="group flex items-center gap-2.5">
          <svg viewBox="0 0 48 48" class="h-11 w-11 transition-transform group-hover:rotate-6" aria-label="哆啦A梦">
            <circle cx="24" cy="22" r="19" fill="#2b9fe3" stroke="#222" stroke-width="2.2" />
            <ellipse cx="24" cy="26" rx="14.5" ry="13" fill="#fff" stroke="#222" stroke-width="1.8" />
            <ellipse cx="19" cy="15.5" rx="4.6" ry="5.4" fill="#fff" stroke="#222" stroke-width="1.6" />
            <ellipse cx="29" cy="15.5" rx="4.6" ry="5.4" fill="#fff" stroke="#222" stroke-width="1.6" />
            <circle cx="20.4" cy="17" r="1.6" fill="#222" />
            <circle cx="27.6" cy="17" r="1.6" fill="#222" />
            <circle cx="24" cy="23" r="2.6" fill="#e5534b" stroke="#222" stroke-width="1.4" />
            <line x1="24" y1="25.6" x2="24" y2="33" stroke="#222" stroke-width="1.4" />
            <path d="M17 30 Q24 35.5 31 30" fill="none" stroke="#222" stroke-width="1.6" stroke-linecap="round" />
            <line x1="6" y1="22" x2="13" y2="23.5" stroke="#222" stroke-width="1.3" stroke-linecap="round" />
            <line x1="6.5" y1="27" x2="13" y2="26.5" stroke="#222" stroke-width="1.3" stroke-linecap="round" />
            <line x1="42" y1="22" x2="35" y2="23.5" stroke="#222" stroke-width="1.3" stroke-linecap="round" />
            <line x1="41.5" y1="27" x2="35" y2="26.5" stroke="#222" stroke-width="1.3" stroke-linecap="round" />
            <rect x="13" y="37" width="22" height="4.5" rx="2.2" fill="#e5534b" stroke="#222" stroke-width="1.6" />
            <circle cx="24" cy="44.5" r="2.8" fill="#febc2e" stroke="#222" stroke-width="1.4" />
          </svg>
          <span class="leading-tight">
            <span class="block text-lg font-extrabold text-dora-deep">DSH 源码图鉴</span>
            <span class="block text-[11px] font-semibold tracking-wide text-ink/50">哆啦A梦带队读源码</span>
          </span>
        </a>
        <nav class="ml-auto hidden items-center gap-1.5 md:flex">
          {chapters.map((c) => {
            const active = Astro.url.pathname.startsWith(`/chapters/${c.slug}`);
            return (
              <a
                href={`/chapters/${c.slug}`}
                class:list={[
                  'group relative flex h-9 items-center justify-center rounded-full border text-[13px] font-extrabold transition-all hover:-translate-y-0.5',
                  active
                    ? 'on-accent gap-1.5 border-transparent px-3'
                    : 'w-9 border-[#d5e3f0] bg-card text-ink/60 hover:border-dora hover:bg-dora hover:text-white',
                ]}
              >
                {active ? (
                  <>
                    <span>{c.num}</span>
                    <span class="whitespace-nowrap">{c.title}</span>
                  </>
                ) : (
                  c.num
                )}
                {!active && (
                  <span class="pointer-events-none absolute -bottom-9 left-1/2 z-50 -translate-x-1/2 scale-90 rounded-lg border border-[#d5e3f0] bg-card px-2.5 py-1 text-xs font-bold whitespace-nowrap text-dora-deep opacity-0 shadow-[0_8px_18px_rgba(27,95,170,0.1)] transition-all group-hover:scale-100 group-hover:opacity-100">
                    {c.title}
                  </span>
                )}
              </a>
            );
          })}
          <a
            href="/appendix/symbols"
            class:list={[
              'ml-2.5 flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-[13px] font-extrabold transition-all hover:-translate-y-0.5',
              inAppendix
                ? 'on-accent border-transparent'
                : 'border-transparent bg-dora-deep text-white hover:bg-dora',
            ]}
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.75C4 .784 4.784 0 5.75 0h5.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 14.25 16h-8.5A1.75 1.75 0 0 1 4 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 11 4.25V1.5Zm2.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914ZM1.5 3.25a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75m.75 2.25a.75.75 0 0 0 0 1.5h.5a.75.75 0 0 0 0-1.5Zm-.75 3.75a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75m.75 3.25a.75.75 0 0 0 0 1.5h.5a.75.75 0 0 0 0-1.5Z"/></svg>
            附录
          </a>
        </nav>
        <details class="relative ml-auto md:hidden">
          <summary class="cursor-pointer rounded-full border border-[#d5e3f0] bg-card px-3.5 py-1.5 text-sm font-bold">
            {currentChapter ? `${currentChapter.num} ${currentChapter.title}` : inAppendix ? '附录' : '章节'}
          </summary>
          <div class="absolute right-0 mt-2 w-56 comic-card p-2">
            {chapters.map((c) => (
              <a
                href={`/chapters/${c.slug}`}
                class:list={[
                  'block rounded-lg px-3 py-2 text-sm hover:bg-mist',
                  currentChapter?.slug === c.slug && 'bg-mist font-extrabold text-dora-deep',
                ]}
              >
                {c.num} {c.title}
              </a>
            ))}
            <a
              href="/appendix/symbols"
              class:list={[
                'block rounded-lg px-3 py-2 text-sm font-bold hover:bg-mist',
                inAppendix ? 'bg-mist text-dora-deep' : 'text-dora-deep',
              ]}
            >
              附录
            </a>
          </div>
        </details>
      </div>
      <div class="h-[3px] bg-gradient-to-r from-dora via-accent to-dora-deep"></div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-[#d5e3f0] bg-card">
      <div class="mx-auto max-w-7xl px-4 py-6 text-sm text-ink/60">
        <p>DSH 源码图鉴 · 基于 deepseek-harness 仓库真实源码撰写 · 亮白模式限定 · 部署于 Railway</p>
      </div>
    </footer>
  </body>
</html>
