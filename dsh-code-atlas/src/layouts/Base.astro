---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'DSH（deepseek-harness）源码深度分析：哆啦A梦带队，逐行吃透插件式 agent harness' } = Astro.props;

const chapters = [
  { slug: '01-plugin-universe', num: '01', title: '插件宇宙观' },
  { slug: '02-loader', num: '02', title: '装载与卸载' },
  { slug: '03-capability-seam', num: '03', title: '接口学' },
  { slug: '04-session-memory', num: '04', title: '记忆真相' },
  { slug: '05-agent-loop', num: '05', title: '循环内部' },
  { slug: '06-layers-approval', num: '06', title: '分层与审批' },
  { slug: '07-subagent', num: '07', title: '分身术' },
  { slug: '08-self-mod-compaction', num: '08', title: '自改装与瘦身' },
  { slug: '09-production', num: '09', title: '走向生产' },
];
const currentChapter = chapters.find((c) => Astro.url.pathname.startsWith(`/chapters/${c.slug}`));
const inAppendix = Astro.url.pathname.startsWith('/appendix');

const appendixLinks = [
  { href: '/appendix/symbols', label: '符号索引' },
  { href: '/appendix/events', label: '事件图谱' },
  { href: '/appendix/glossary', label: '术语表' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#faf6ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/art/icon-192.png" />
    <meta property="og:title" content={`${title} · DSH 源码图鉴`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/art/hero-home.webp" />
    <title>{title} · DSH 源码图鉴</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b-2 border-dora-deep bg-paper/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-2 px-3 py-2.5 md:gap-4 md:px-4">
        <a href="/" class="group flex min-w-0 items-center gap-2.5">
          <img src="/art/mascot.webp" alt="源码图鉴吉祥物：蓝色小机器猫工程师" width="48" height="48" class="h-12 w-12 shrink-0 object-cover transition-transform group-hover:-rotate-6" />
          <span class="min-w-0 shrink-0 leading-tight">
            <span class="block whitespace-nowrap text-base font-extrabold text-dora-deep md:text-lg">DSH 源码图鉴</span>
            <span class="hidden text-[11px] font-semibold tracking-wide text-ink/55 md:block">哆啦A梦带队读源码 · 绘本式源码精读</span>
          </span>
        </a>
        <nav class="ml-auto hidden items-center gap-1.5 md:flex" aria-label="章节导航">
          {chapters.map((c) => {
            const active = Astro.url.pathname.startsWith(`/chapters/${c.slug}`);
            return (
              <a
                href={`/chapters/${c.slug}`}
                class:list={[
                  'group relative flex h-9 items-center justify-center border-2 text-[13px] font-extrabold transition-all hover:-translate-y-0.5',
                  'rounded-[13px_16px_14px_17px]',
                  active
                    ? 'on-accent gap-1.5 border-dora-deep px-3 shadow-[3px_3px_0_rgba(27,95,170,0.2)]'
                    : 'w-9 border-dora-deep/35 bg-card text-ink/60 shadow-[2px_2px_0_rgba(27,95,170,0.1)] hover:border-dora-deep hover:bg-mist hover:text-dora-deep',
                ]}
              >
                {active ? (
                  <>
                    <span>{c.num}</span>
                    <span class="whitespace-nowrap">{c.title}</span>
                  </>
                ) : (
                  c.num
                )}
                {!active && (
                  <span class="pointer-events-none absolute -bottom-10 left-1/2 z-50 -translate-x-1/2 scale-90 rounded-[10px_13px_11px_14px] border-2 border-dora-deep bg-card px-2.5 py-1 text-xs font-bold whitespace-nowrap text-dora-deep opacity-0 shadow-[3px_3px_0_rgba(27,95,170,0.15)] transition-all group-hover:scale-100 group-hover:opacity-100">
                    {c.title}
                  </span>
                )}
              </a>
            );
          })}
          <a
            href="/appendix/symbols"
            class:list={[
              'ml-2.5 flex items-center gap-1.5 rounded-[13px_16px_14px_17px] border-2 border-dora-deep px-3.5 py-1.5 text-[13px] font-extrabold shadow-[3px_3px_0_rgba(27,95,170,0.2)] transition-all hover:-translate-y-0.5',
              inAppendix ? 'on-accent' : 'bg-dora-deep text-white hover:bg-dora',
            ]}
          >
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.4 3.2h4.2c.9 0 1.4.7 1.4 1.5v8.2c0-.9-.6-1.5-1.4-1.5H2.4z" />
              <path d="M13.6 3.2H9.4c-.9 0-1.4.7-1.4 1.5v8.2c0-.9.6-1.5 1.4-1.5h4.2z" />
            </svg>
            附录
          </a>
        </nav>
        <details class="relative ml-auto md:hidden">
          <summary class="cursor-pointer whitespace-nowrap rounded-[13px_16px_14px_17px] border-2 border-dora-deep bg-card px-2.5 py-1.5 text-xs font-bold shadow-[3px_3px_0_rgba(27,95,170,0.14)]">
            {currentChapter ? `${currentChapter.num} ${currentChapter.title}` : inAppendix ? '附录' : '章节'}
          </summary>
          <div class="absolute right-0 mt-3 w-56 comic-card p-2">
            {chapters.map((c) => (
              <a
                href={`/chapters/${c.slug}`}
                class:list={[
                  'block rounded-[10px_13px_11px_14px] px-3 py-2 text-sm hover:bg-mist',
                  currentChapter?.slug === c.slug && 'bg-mist font-extrabold text-dora-deep',
                ]}
              >
                {c.num} {c.title}
              </a>
            ))}
            <a
              href="/appendix/symbols"
              class:list={[
                'block rounded-[10px_13px_11px_14px] px-3 py-2 text-sm font-bold hover:bg-mist',
                inAppendix ? 'bg-mist text-dora-deep' : 'text-dora-deep',
              ]}
            >
              附录
            </a>
          </div>
        </details>
      </div>
      <!-- 套色印刷条：蓝→橙→薄荷，压在描边之下 -->
      <div class="h-[4px] bg-gradient-to-r from-dora via-accent to-mint"></div>
    </header>

    <main class="mx-auto w-full min-w-0 max-w-7xl flex-1 overflow-x-clip px-4 py-8">
      <slot />
    </main>

    <footer class="relative mt-16 border-t-2 border-dora-deep bg-card">
      <!-- 页脚上沿的缝线：呼应贴纸/剪纸质感 -->
      <div class="absolute inset-x-0 -top-[9px] h-[14px] bg-[repeating-linear-gradient(90deg,#1b5faa_0_10px,transparent_10px_20px)] opacity-25" aria-hidden="true"></div>

      <div class="mx-auto grid max-w-7xl gap-8 px-4 pt-10 pb-4 md:grid-cols-[1.15fr_1fr_0.85fr]">
        <div>
          <div class="flex items-center gap-3">
            <img src="/art/mascot.webp" alt="" width="52" height="52" class="h-13 w-13 shrink-0 object-cover" />
            <div>
              <div class="text-base font-extrabold text-dora-deep">DSH 源码图鉴</div>
              <div class="text-xs font-semibold text-ink/55">一本会讲故事的源码书</div>
            </div>
          </div>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink/70">
            九章绘本式精读，把 deepseek-harness 的插件宇宙从内核讲到生产线。
            每一句论断都锚定仓库里的真实代码，每一章都配一幅手绘意象图陪着 UML 一起看。
          </p>
        </div>

        <div>
          <div class="section-title text-sm font-extrabold text-dora-deep">阅读路线</div>
          <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
            {chapters.map((c) => (
              <li>
                <a href={`/chapters/${c.slug}`} class="group flex items-center gap-1.5 text-ink/70 transition-colors hover:text-dora-deep">
                  <span class="font-mono text-[11px] font-bold text-accent">{c.num}</span>
                  <span class="group-hover:underline group-hover:decoration-wavy group-hover:decoration-dora">{c.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="section-title section-title-accent text-sm font-extrabold text-dora-deep">随手查</div>
          <ul class="mt-4 space-y-1.5 text-sm">
            {appendixLinks.map((l) => (
              <li>
                <a href={l.href} class="text-ink/70 transition-colors hover:text-dora-deep hover:underline hover:decoration-wavy hover:decoration-accent">
                  {l.label}
                </a>
              </li>
            ))}
            <li>
              <a href="/" class="text-ink/70 transition-colors hover:text-dora-deep hover:underline hover:decoration-wavy hover:decoration-accent">回到全站地图</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- 页脚插画长条：小机器猫和大雄在纸山纸云前挥手告别 -->
      <img
        src="/art/footer-band.webp"
        alt="页脚插画：吉祥物小机器猫与戴眼镜的小男孩站在纸质山丘与云朵前挥手，左侧排着收音机、齿轮、纸船、油灯与图纸等道具"
        loading="lazy"
        decoding="async"
        class="mt-4 block w-full"
      />

      <div class="border-t-2 border-dora-deep/25 bg-paper">
        <div class="site-footer-legal mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-1 px-4 pt-4 text-xs text-ink/60">
          <span>DSH 源码图鉴</span>
          <span aria-hidden="true" class="text-accent">◆</span>
          <span>基于 deepseek-harness 仓库真实源码撰写</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.querySelectorAll('.prose-atlas table').forEach((table) => {
        const heads = [...table.querySelectorAll('thead th')].map((th) => th.textContent.trim());
        table.querySelectorAll('tbody tr').forEach((tr) => {
          [...tr.children].forEach((td, i) => {
            if (heads[i]) td.setAttribute('data-label', heads[i]);
          });
        });
      });
    </script>
  </body>
</html>
