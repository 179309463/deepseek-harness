---
interface Panel {
  who: 'doraemon' | 'nobita' | 'suneo' | 'gian';
  text: string;
}

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;

/**
 * 出场角色：头像是同一套丝网印刷画风的卡通贴纸。
 * alt 描述画面而不是角色名，因为角色名已经以文字形式就在气泡上方。
 */
const cast: Record<Panel['who'], { name: string; avatar: string; alt: string }> = {
  doraemon: { name: '哆啦A梦', avatar: '/art/avatar-doraemon.webp', alt: '蓝色小机器猫工程师的卡通头像，头顶两根天线，系着橙色围巾' },
  nobita: { name: '大雄', avatar: '/art/avatar-nobita.webp', alt: '戴圆框眼镜、蓝色蓬松短发的小男孩卡通头像，张嘴兴奋地提问' },
  suneo: { name: '小夫', avatar: '/art/avatar-suneo.webp', alt: '棕色中分短发、眯眼坏笑的瘦小男孩卡通头像' },
  gian: { name: '胖虎', avatar: '/art/avatar-gian.webp', alt: '穿橙红 T 恤、浓眉不服气的胖乎乎小男孩卡通头像' },
};
---

<div class="story-chat my-8 flex flex-col gap-5">
  {panels.map((p) => {
    const c = cast[p.who];
    // 哆啦A梦是讲解者，固定占左侧；提问的人类角色一律靠右，靠边站位本身就区分了「答」和「问」。
    const right = p.who !== 'doraemon';
    return (
      <div class:list={['flex w-full', right ? 'justify-end' : 'justify-start']}>
        <div class:list={['flex max-w-[min(40rem,92%)] items-start gap-3', right && 'flex-row-reverse']}>
          <img
            src={c.avatar}
            alt={c.alt}
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="h-12 w-12 shrink-0 bg-transparent object-contain"
          />
          <div class:list={['min-w-0', right && 'text-right']}>
            <div class="mb-1 text-xs font-bold text-ink/45">{c.name}</div>
            <div class:list={['speech-bubble text-left text-[0.92rem]', right ? 'bubble-right' : 'bubble-left']}>
              {p.text}
            </div>
          </div>
        </div>
      </div>
    );
  })}
</div>
