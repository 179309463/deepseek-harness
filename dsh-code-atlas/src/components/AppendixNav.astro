---
interface Props {
  current: 'symbols' | 'events' | 'glossary';
}

const { current } = Astro.props;

const links = [
  { key: 'symbols', href: '/appendix/symbols', label: '符号索引' },
  { key: 'events', href: '/appendix/events', label: '事件图谱' },
  { key: 'glossary', href: '/appendix/glossary', label: '术语表' },
] as const;
---

<nav class="mb-8 flex flex-wrap gap-3" aria-label="附录导航">
  {links.map((l) => (
    <a
      href={l.href}
      class:list={[
        'comic-card px-4 py-2 text-sm font-bold transition hover:-translate-y-0.5',
        l.key === current ? 'bg-dora text-white' : 'bg-card text-dora-deep hover:bg-mist',
      ]}
    >
      {l.label}
    </a>
  ))}
</nav>
