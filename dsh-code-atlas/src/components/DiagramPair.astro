---
interface Props {
  /** 宽屏左右对读时的对照说明 */
  note?: string;
  /** 窄屏上下叠放时的对照说明；未传时若也未传 note，用「上图 / 下图」默认句 */
  noteStacked?: string;
}

const { note, noteStacked } = Astro.props;
const noteRow = note ?? '同一件事：左图讲机制，右图讲意象';
const noteCol = noteStacked ?? (note == null ? '同一件事：上图讲机制，下图讲意象' : note);
---

<div class="diagram-duo">
  <div class="diagram-duo-stage">
    <slot />
  </div>
  <p class="diagram-duo-note diagram-duo-note-stack">{noteCol}</p>
  <p class="diagram-duo-note diagram-duo-note-row">{noteRow}</p>
</div>
